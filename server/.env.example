PORT=3000
CORS_ORIGIN=*
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tuneng_db
DB_USER=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
WECHAT_APPID=
WECHAT_APPSECRET=
ALLOW_DEMO_LOGIN=false
ADMIN_BOOTSTRAP_USERNAME=admin
# 必须使用至少 10 位、仅用于首次创建管理员的强密码；首次创建后可从本地 .env 删除该项。
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
RENTAL_START_FEE_CENTS=100
RENTAL_FEE_PER_MINUTE_CENTS=30
